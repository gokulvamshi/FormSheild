generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(cuid())
  firebaseUid            String?   @unique
  email                  String?   @unique
  phone                  String?   @unique
  name                   String?
  avatar                 String?
  language               String    @default("ENGLISH")
  digilockerConnected    Boolean   @default(false)
  digilockerAccessToken  String?
  digilockerRefreshToken String?
  digilockerTokenExpiry  DateTime?
  digilockerUserId       String?
  mockMode               Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  documents   Document[]
  applications Application[]
  activityLogs ActivityLog[]
}

model Document {
  id               String    @id @default(cuid())
  userId           String
  type             String    // DocumentType enum as string
  name             String
  issuingAuthority String?
  issueDate        DateTime?
  expiryDate       DateTime?
  verified         Boolean   @default(false)
  digilockerDocId  String?
  extractedData    String?   // JSON string
  rawFileUrl       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Application {
  id                   String    @id @default(cuid())
  userId               String
  state                String    // ApplicationState enum as string
  category             String    // ApplicationCategory enum as string
  applicationType      String    // ApplicationType enum as string
  status               String    @default("DRAFT") // ApplicationStatus enum as string
  currentStep          Int       @default(1)
  followUpAnswers      String?   // JSON string
  documentCheckResults String?   // JSON string
  generatedFormData    String?   // JSON string
  pdfUrl               String?
  templateId           String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  template     ApplicationTemplate? @relation(fields: [templateId], references: [id])
  activityLogs ActivityLog[]

  @@index([userId, status])
}

model ApplicationTemplate {
  id                     String   @id @default(cuid())
  state                  String   // ApplicationState
  category               String   // ApplicationCategory
  applicationType        String   // ApplicationType
  displayName            String
  description            String
  requiredDocuments      String   // JSON
  eligibilityCriteria    String   // JSON
  followUpQuestions      String   // JSON
  formTemplate           String   // JSON
  officialPortalUrl      String
  fees                   String
  processingTime         String
  submissionInstructions String   // JSON
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  applications Application[]

  @@unique([state, applicationType])
  @@index([state, category])
}

model ActivityLog {
  id            String   @id @default(cuid())
  userId        String
  action        String
  details       String?
  applicationId String?
  createdAt     DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id])

  @@index([userId])
}

model OtpSession {
  id        String   @id @default(cuid())
  phone     String
  otp       String
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}